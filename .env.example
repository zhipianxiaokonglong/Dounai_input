# Dounai Input Gateway — environment variables
#
# Copy to .env for local development. .env is ignored by Git; never commit real
# secrets. All values below are examples and contain no credentials.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# DOUNAI_CONFIG=./dounai.toml
# DOUNAI_DATA_DIR=./data
# DOUNAI_HOST=127.0.0.1
# DOUNAI_PORT=8000
# DOUNAI_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Required when binding to a non-loopback interface:
# DOUNAI_API_TOKEN=replace-with-a-long-random-token
# DOUNAI_ALLOW_INSECURE_BIND=0

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# DOUNAI_VOICEPRINT_ENABLED=0
# DOUNAI_WAKE_PHRASE=你好豆奶
# DOUNAI_VOICEPRINT_THRESHOLD=0.82

# ---------------------------------------------------------------------------
# Providers (BYOK)
# ---------------------------------------------------------------------------
# Recommended third-party provider: Alibaba Cloud Model Studio (Bailian)
# DASHSCOPE_API_KEY=sk-your-own-key
# DASHSCOPE_BASE_URL is configured in dounai.toml, not here.

# Optional OpenAI speech-to-text provider.
# OPENAI_API_KEY=sk-your-own-key

# Optional self-hosted HTTP ASR endpoint. Configure the endpoint in dounai.toml.
# DOUNAI_CUSTOM_HTTP_TOKEN=your-endpoint-token

# Optional model download mirror for users who cannot reach huggingface.co.
# HF_ENDPOINT=https://hf-mirror.com
