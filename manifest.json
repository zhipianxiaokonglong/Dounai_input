{
  "module_id": "dounai-input",
  "name": "输入接入层 · Dounai Input（本地开发）",
  "version": "0.1.0",
  "category": "core",
  "entry": {
    "type": "command",
    "command": "D:/Program/input/.venv/Scripts/python.exe -m dounai_input serve --port 8101",
    "working_dir": "",
    "env": {
      "DOUNAI_PORT": "8101"
    },
    "health": {
      "url": "http://127.0.0.1:8101/healthz",
      "timeout_ms": 8000
    }
  },
  "compat": {
    "app_version": ">=0.1.0"
  },
  "dependencies": [],
  "model_packs": [],
  "permissions": {
    "network": [],
    "filesystem": [],
    "devices": []
  },
  "signature": {
    "algo": "SHA-256 + Ed25519",
    "value": ""
  }
}